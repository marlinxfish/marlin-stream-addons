# Domain gratis sslip.io (Ganti dengan IP publik VPS Anda)
# Contoh: jika IP Anda 20.198.50.123, isi: DOMAIN=20.198.50.123.sslip.io
DOMAIN=YOUR_VPS_IP.sslip.io

# Access Key / Sandi Akses (Opsional: kosongkan jika publik, isi untuk kunci khusus keluarga)
# Contoh: ACCESS_KEY=KeluargaMarlin2026
ACCESS_KEY=

# Server Configuration
HOST=0.0.0.0
PORT=7000

# Providers (set "false" untuk mematikan provider)
PROVIDER_OPPADRAMA_ENABLED=true
OPPADRAMA_BASE_URL=http://212.86.121.175
PROVIDER_NONTONANIMEID_ENABLED=true
NONTONANIMEID_BASE_URL=https://s13.nontonanimeid.boats

# Addon Branding (Tampilan di Stremio)
ADDON_NAME="Marlin Stream"
ADDON_ICON="🐟"
# Optional: Proxy untuk scraping agar IP tidak di-ban (HTTP/HTTPS/SOCKS5)
# Contoh: PROXY_URL=http://127.0.0.1:1080 atau socks5://127.0.0.1:9050
# PROXY_URL=

# Cache Settings (dalam detik)
CACHE_STREAM_TTL=3600
CACHE_META_TTL=86400

# Request Timeout (dalam milidetik)
REQUEST_TIMEOUT_MS=6000
